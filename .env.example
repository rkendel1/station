# Codespace and AI Configuration
# Copy this file to .env and set your values at runtime
# NEVER commit actual values to the repository

# GPU Worker Configuration
# Used for connecting to remote GPU inference endpoint from Codespace

# Provider type (openai-compatible, openai, anthropic, etc.)
AI_PROVIDER=openai-compatible

# GPU Worker endpoint URL (must use HTTPS in production)
# Example: https://your-worker-pod.runpod.io/v1
AI_BASE_URL=

# Model name to use for inference
# Example: Qwen3-Coder-30B, Mistral-7B-Instruct
AI_MODEL=Qwen3-Coder-30B

# API key for authentication with GPU worker
# IMPORTANT: Set at runtime, never commit to repository
# Example: abc123def456ghi789
AI_API_KEY=
