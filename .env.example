# Codespace and AI Configuration
# Copy this file to .env and set your values at runtime
# NEVER commit actual values to the repository

# AI Router Configuration
# The AI Router is the single logical endpoint for AI in your development environment
# It selects the appropriate model based on task type, cost constraints, and availability

# Provider type
# Options: openai-compatible (Qwen on RunPod), openai (GPT-4), anthropic (Claude)
# Set by: ai model [qwen|frontier|claude]
AI_PROVIDER=openai-compatible

# AI endpoint URL
# For Qwen: https://[pod-id].runpod.net/v1
# For OpenAI: https://api.openai.com/v1
# Set by: ai model [qwen|frontier|claude] or AI Router
AI_BASE_URL=

# Model name to use for inference
# Examples: Qwen3-Coder-30B, gpt-4-turbo-preview, claude-3-opus-20240229
# Set by: ai model [qwen|frontier|claude]
AI_MODEL=Qwen3-Coder-30B

# API key for authentication
# IMPORTANT: Set at runtime, never commit to repository
# For Qwen: RunPod worker token
# For OpenAI: sk-...
# For Anthropic: sk-ant-...
# Set by: ai model [qwen|frontier|claude] or export manually
AI_API_KEY=

# Active AI profile for development
# Options: default, cost_sensitive, quality_first, balanced, exploration
# Default: balanced (automatically set by AI Router)
# Set by: ai profile [name]
AI_PROFILE=balanced

# GPU Worker Configuration (for RunPod Qwen deployment)
# RunPod Pod ID (from RunPod console)
# Set by: export RUNPOD_POD_ID=xxx or RunPod GUI
RUNPOD_POD_ID=

# RunPod API Key (for pod control)
# Set at runtime, never commit to repository
RUNPOD_API_KEY=

# RunPod Worker Key (for authentication to the worker)
# Set at runtime, never commit to repository
RUNPOD_WORKER_KEY=

# Frontend AI Provider Configuration (for Codex CLI)
# These are automatically set by the ai command
CODEX_LLM_PROVIDER=openai-compatible
CODEX_LLM_BASE_URL=
CODEX_LLM_MODEL=Qwen3-Coder-30B
CODEX_LLM_API_KEY=

# Note on the AI Router Architecture:
#
# Instead of hardcoding which model to use, the AI Router decides based on:
# - Task type (implementation, debugging, architecture, etc.)
# - Active profile (cost-sensitive, quality-first, balanced)
# - Model availability (Qwen requires GPU to be running)
# - Cost constraints (daily/monthly limits)
#
# This separation means:
# - Codex doesn't know about RunPod
# - You can switch models with: ai model [qwen|frontier|claude]
# - Profiles let you change behavior globally without code changes
# - Future models integrate without updating Codex
#
# See docs/AI_ROUTER.md for complete documentation
