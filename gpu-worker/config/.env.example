# GPU Worker Configuration Template

# Model Configuration
MODEL_NAME=Qwen3-Coder-30B

# GPU Configuration
GPU_TYPE=h100
GPU_MEMORY_REQUIREMENT=80

# Runtime Configuration
CONTEXT_LENGTH=4096
MAX_CONCURRENCY=4

# Worker Configuration
WORKER_NAME=gpu-worker
PROVIDER=runpod
PORT=8000
VLLM_PORT=8001

# Shutdown Configuration
IDLE_TIMEOUT_MINUTES=30

# Authentication
# IMPORTANT: Set at runtime, never commit to repository
# API_KEY=<runtime-secret>
